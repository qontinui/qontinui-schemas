  "components": [
    {
      "actionInvocationPath": "/ui-bridge/control/component/setup-wizard/action/{actionId}",
      "actions": [
        {
          "description": "Mark setup complete and dismiss the wizard. Persists via the same `complete_setup` Tauri command the user-driven 'Finish' button uses. Does NOT save process configs — a programmatic caller has picked none.",
          "id": "complete",
          "label": "Complete Setup"
        },
        {
          "description": "Open the wizard at a specific step. Values 0-6 correspond to: Tier, Welcome, Projects, Processes, Dev Services, AI Provider, Claude Sessions. NON-DESTRUCTIVE: opening flips in-memory view state only; the persisted `setup_completed` setting is untouched.",
          "id": "go-to-step",
          "label": "Jump to Step"
        }
      ],
      "description": "First-launch onboarding wizard. Use 'complete' to dismiss programmatically without driving 7 step interactions. Use 'go-to-step' to jump to a specific step (0-6) — this also OPENS the wizard if it is currently dismissed, which is how you reach first-run surfaces on a runner that auto-bypassed setup (any supervisor temp runner, unless spawned with extra_env: { QONTINUI_TEST_AUTO_LOGIN_EMAIL: \"\" }).",
      "elementIds": [],
      "id": "setup-wizard",
      "mounted": true,
      "name": "Setup Wizard",
      "registeredAt": 1788980430435,
      "scope": "global"
    },
    {
      "actionInvocationPath": "/ui-bridge/control/component/terminal-page/action/{actionId}",
      "actions": [
        {
          "description": "Spawn a new PTY-backed terminal tab and assign it to the next free zone.",
          "id": "create-terminal",
          "label": "Create Terminal"
        },
        {
          "description": "Spawn one plain (non-AI) PTY terminal in the user's default shell, assign it to the active page's next free zone, and mount its xterm. Robust from a fresh page. Returns { success, tab_id }. Use this to drive the terminal surface headlessly.",
          "id": "create-plain-terminal",
          "label": "Create Plain Terminal"
        },
        {
          "description": "Return [{id, title, isAlive}] for every currently mounted terminal tab.",
          "id": "list-terminals",
          "label": "List Terminals"
        },
        {
          "description": "Open a new pop-out OS window (same process) that hosts its own terminal tabs. Returns the new window record { label, kind, ... }.",
          "id": "open-terminal-window",
          "label": "Open Terminal Window"
        },
        {
          "description": "Open a new pop-out window and move the active terminal tab into it. Returns { window, terminalId }.",
          "id": "pop-out-active-terminal",
          "label": "Pop Out Active Terminal"
        },
        {
          "description": "Detach an ENTIRE terminal page (all its terminals + zone layout) into its own pop-out window bound to the page. Params: { pageId?: string } (defaults to the active page). Returns { window, pageId }.",
          "id": "pop-out-page",
          "label": "Pop Out Page"
        },
        {
          "description": "Move a terminal tab to a window. Params: { terminalId: string, windowLabel: string } where windowLabel is 'main' or 'term-N'.",
          "id": "move-terminal-to-window",
          "label": "Move Terminal To Window"
        },
        {
          "description": "Maximize one zone to fill the page. Params: { zoneIndex: number }. Returns { maximizedZone, previousMaximizedZone, zoneCount, changed }.",
          "id": "maximize-zone",
          "label": "Maximize Zone"
        },
        {
          "description": "Leave the maximized view and return to the tiled layout. No params. Returns { maximizedZone: null, previousMaximizedZone, zoneCount, changed } — `changed: false` means nothing was maximized.",
          "id": "restore-zone",
          "label": "Restore Zone"
        },
        {
          "description": "Maximize the given zone, or restore if it is already maximized — the same rule the keyboard shortcut uses. Params: { zoneIndex: number }.",
          "id": "toggle-maximize-zone",
          "label": "Toggle Maximize Zone"
        },
        {
          "description": "Return { maximizedZone, zoneCount, layoutId } — the read that lets a caller assert the maximized view without inferring it from a DOM snapshot.",
          "id": "get-zone-view-state",
          "label": "Get Zone View State"
        },
        {
          "description": "Return this runner process's own windows [{ label, kind, title }] (main + pop-outs).",
          "id": "list-runner-windows",
          "label": "List Runner Windows"
        },
        {
          "description": "Close every pop-out OS window that has no live terminal tab and prune its record; also prunes records for pop-outs whose OS window is already gone (the recovery path when a stale page binding is hiding a page and the grid shows zero zones). Returns the labels closed.",
          "id": "close-empty-terminal-windows",
          "label": "Close Empty Terminal Windows"
        }
      ],
      "description": "Multi-terminal workspace with zone-based layout. Agents can create terminals via HTTP POST /terminals with initialCommand.",
      "elementIds": [
        "terminal-zone-minimap",
        "terminal.command-bar-input",
        "terminal.session-manager-toggle",
        "svg-child-1",
        "terminal-zone-minimap-toggle",
        "terminal-page-generic-1"
      ],
      "id": "terminal-page",
      "mounted": true,
      "name": "Terminal Page",
      "registeredAt": 1788980430459
    }
